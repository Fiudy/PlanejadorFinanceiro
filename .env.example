# Copie este arquivo para ".env" e preencha para ativar o Firebase.
# Sem estas variáveis, o app roda automaticamente em modo local
# (localStorage), sem precisar de nenhuma configuração.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=planejador-financeiro-bfd79
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Chave da API do Gemini, usada no navegador para ler faturas de cartão em PDF
# (Cartões > fatura > Importar PDF). Fica embutida no bundle do app — qualquer
# pessoa com acesso ao site consegue extraí-la, então use uma chave dedicada
# a esse uso e restrinja-a (quota baixa e/ou restrição por domínio/referrer)
# no Google AI Studio / Google Cloud Console.
VITE_GEMINI_API_KEY=
